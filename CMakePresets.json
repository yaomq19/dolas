{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "vs2022",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "vs2022-debug",
      "inherits": "vs2022",
      "displayName": "VS2022 Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2022-release",
      "inherits": "vs2022",
      "displayName": "VS2022 Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "base",
      "generator": "Unix Makefiles"
    },
    {
      "name": "macos-vulkan-debug",
      "inherits": "macos",
      "displayName": "macOS Vulkan Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DOLAS_RENDER_BACKEND": "Vulkan",
        "ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "macos-vulkan-release",
      "inherits": "macos",
      "displayName": "macOS Vulkan Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DOLAS_RENDER_BACKEND": "Vulkan",
        "ENABLE_VULKAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "macos-vulkan-debug",
      "configurePreset": "macos-vulkan-debug"
    },
    {
      "name": "macos-vulkan-release",
      "configurePreset": "macos-vulkan-release"
    }
  ],
  "testPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "macos-vulkan-debug",
      "configurePreset": "macos-vulkan-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-vulkan-release",
      "configurePreset": "macos-vulkan-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
